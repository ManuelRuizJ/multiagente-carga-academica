    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Persona</IRI><Literal xml:lang="es">Persona</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Persona</IRI><Literal xml:lang="es">Superclase de los actores del sistema.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Estudiante</IRI><Literal xml:lang="es">Estudiante</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Estudiante</IRI><Literal xml:lang="es">Usuario al que se recomienda la carga académica.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Profesor</IRI><Literal xml:lang="es">Profesor</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Profesor</IRI><Literal xml:lang="es">Docente que imparte grupos.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Asesor</IRI><Literal xml:lang="es">Asesor</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Asesor</IRI><Literal xml:lang="es">Tutor académico que valida recomendaciones.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ProgramaEducativo</IRI><Literal xml:lang="es">ProgramaEducativo</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ProgramaEducativo</IRI><Literal xml:lang="es">Carrera o licenciatura a la que pertenece el plan.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PlanDeEstudios</IRI><Literal xml:lang="es">PlanDeEstudios</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PlanDeEstudios</IRI><Literal xml:lang="es">Versión vigente del currículo de un programa.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Materia</IRI><Literal xml:lang="es">Materia</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Materia</IRI><Literal xml:lang="es">Unidad curricular del plan; clase central.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#MateriaObligatoria</IRI><Literal xml:lang="es">MateriaObligatoria</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#MateriaObligatoria</IRI><Literal xml:lang="es">Materia de cursado forzoso.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#MateriaOptativa</IRI><Literal xml:lang="es">MateriaOptativa</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#MateriaOptativa</IRI><Literal xml:lang="es">Materia elegible de una lista del plan.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#MateriaElectiva</IRI><Literal xml:lang="es">MateriaElectiva</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#MateriaElectiva</IRI><Literal xml:lang="es">Materia de libre elección.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AreaConocimiento</IRI><Literal xml:lang="es">AreaConocimiento</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AreaConocimiento</IRI><Literal xml:lang="es">Agrupación temática (matemáticas, programación, etc.).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Semestre</IRI><Literal xml:lang="es">Semestre</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Semestre</IRI><Literal xml:lang="es">Posición sugerida de la materia en la retícula.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PeriodoEscolar</IRI><Literal xml:lang="es">PeriodoEscolar</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PeriodoEscolar</IRI><Literal xml:lang="es">Ciclo en que se inscribe (ej. Ene-Jun 2027).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Grupo</IRI><Literal xml:lang="es">Grupo</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Grupo</IRI><Literal xml:lang="es">Oferta concreta de una materia con horario y cupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Horario</IRI><Literal xml:lang="es">Horario</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Horario</IRI><Literal xml:lang="es">Día y franja horaria de un grupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Aula</IRI><Literal xml:lang="es">Aula</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Aula</IRI><Literal xml:lang="es">Espacio físico de un grupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroAcademico</IRI><Literal xml:lang="es">RegistroAcademico</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroAcademico</IRI><Literal xml:lang="es">Cursado de una materia por un estudiante.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroAprobado</IRI><Literal xml:lang="es">RegistroAprobado</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroAprobado</IRI><Literal xml:lang="es">Materia acreditada.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroReprobado</IRI><Literal xml:lang="es">RegistroReprobado</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroReprobado</IRI><Literal xml:lang="es">Materia no acreditada.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RegistroEnCurso</IRI><Literal xml:lang="es">RegistroEnCurso</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RegistroEnCurso</IRI><Literal xml:lang="es">Materia actualmente cursando.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#RestriccionDeCarga</IRI><Literal xml:lang="es">RestriccionDeCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#RestriccionDeCarga</IRI><Literal xml:lang="es">Límites de créditos o materias por periodo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Recomendacion</IRI><Literal xml:lang="es">Recomendacion</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Recomendacion</IRI><Literal xml:lang="es">Resultado del agente para un estudiante y periodo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Modalidad</IRI><Literal xml:lang="es">Modalidad</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Modalidad</IRI><Literal xml:lang="es">Forma de impartir un grupo.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadPresencial</IRI><Literal xml:lang="es">ModalidadPresencial</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadPresencial</IRI><Literal xml:lang="es">Clases en el campus.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadEnLinea</IRI><Literal xml:lang="es">ModalidadEnLinea</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadEnLinea</IRI><Literal xml:lang="es">Clases totalmente remotas.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ModalidadHibrida</IRI><Literal xml:lang="es">ModalidadHibrida</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ModalidadHibrida</IRI><Literal xml:lang="es">Combinación de presencial y remoto.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Preferencia</IRI><Literal xml:lang="es">Preferencia</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Preferencia</IRI><Literal xml:lang="es">Preferencia del alumno extraída de su lenguaje natural por el LLM.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaHorario</IRI><Literal xml:lang="es">PreferenciaHorario</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaHorario</IRI><Literal xml:lang="es">Preferencia de turno u horas (ej. clases por la tarde).</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaModalidad</IRI><Literal xml:lang="es">PreferenciaModalidad</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaModalidad</IRI><Literal xml:lang="es">Preferencia por presencial, en línea o híbrido.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PreferenciaCarga</IRI><Literal xml:lang="es">PreferenciaCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PreferenciaCarga</IRI><Literal xml:lang="es">Preferencia por carga ligera o número de materias/créditos.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Agente</IRI><Literal xml:lang="es">Agente</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Agente</IRI><Literal xml:lang="es">Agente de software del sistema multiagente.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteHistorial</IRI><Literal xml:lang="es">AgenteHistorial</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteHistorial</IRI><Literal xml:lang="es">Analista de historial y requisitos.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteCarga</IRI><Literal xml:lang="es">AgenteCarga</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteCarga</IRI><Literal xml:lang="es">Analista de carga académica.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteHorarios</IRI><Literal xml:lang="es">AgenteHorarios</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteHorarios</IRI><Literal xml:lang="es">Analista de horarios y preferencias.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AgenteManager</IRI><Literal xml:lang="es">AgenteManager</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AgenteManager</IRI><Literal xml:lang="es">Coordinador y recomendador.</Literal></AnnotationAssertion>
