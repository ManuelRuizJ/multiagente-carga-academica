<owl:Ontology rdf:about="http://www.ibero.mx/ontologias/plan-estudios">
  <rdfs:label xml:lang="es">Ontología del plan de estudios para la recomendación de carga académica</rdfs:label>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#perteneceAPlan">
  <owl:inverseOf rdf:resource="#contieneMateria"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#PlanDeEstudios"/>
  <rdfs:label xml:lang="es">perteneceAPlan</rdfs:label>
  <rdfs:comment xml:lang="es">Cada materia pertenece a un plan.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contieneMateria">
  <rdfs:domain rdf:resource="#PlanDeEstudios"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">contieneMateria</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de perteneceAPlan.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tienePlan">
  <owl:inverseOf rdf:resource="#esPlanDe"/>
